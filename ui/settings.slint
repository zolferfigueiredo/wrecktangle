import { Button, LineEdit, Palette, ScrollView, Switch } from "std-widgets.slint";

export struct ShortcutRow {
    keys: [string],
    note: string,
    warn: bool,
    recording: bool,
    hint: string,
}

global Ui {
    out property <brush> text-secondary: Palette.foreground.with-alpha(0.72);
    out property <brush> text-tertiary: Palette.foreground.with-alpha(0.55);
    out property <brush> divider: Palette.foreground.with-alpha(0.08);
    out property <brush> card-border: Palette.foreground.with-alpha(0.1);
    out property <color> warning: Palette.color-scheme == ColorScheme.dark ? #ffc83d : #9d5d00;
    out property <color> error: Palette.color-scheme == ColorScheme.dark ? #ff99a4 : #c42b1c;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Ui.divider;
}

component Card inherits Rectangle {
    background: Palette.control-background;
    border-radius: 6px;
    border-width: 1px;
    border-color: Ui.card-border;

    VerticalLayout {
        alignment: start;

        @children
    }
}

component SectionTitle inherits Text {
    font-size: 14px;
    font-weight: 600;
    color: Palette.foreground;
}

component PivotItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback activated();

    border-radius: 4px;
    background: area.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;

        Text {
            text: root.text;
            font-size: 14px;
            font-weight: root.selected ? 600 : 400;
            color: root.selected ? Palette.foreground : Ui.text-secondary;
            vertical-alignment: center;
        }
    }

    Rectangle {
        visible: root.selected;
        x: (parent.width - self.width) / 2;
        y: parent.height - 5px;
        width: 18px;
        height: 3px;
        border-radius: 1.5px;
        background: Palette.accent-background;
    }

    if focus.has-focus: Rectangle {
        border-radius: 4px;
        border-width: 2px;
        border-color: Palette.accent-background;
    }

    area := TouchArea {
        clicked => {
            focus.focus();
            root.activated();
        }
    }
}

component LayoutIcon inherits Rectangle {
    in property <float> fx;
    in property <float> fy;
    in property <float> fw;
    in property <float> fh;
    in property <int> glyph;

    width: 30px;
    height: 22px;
    border-radius: 3px;
    border-width: 1.5px;
    border-color: Palette.foreground.with-alpha(0.5);
    background: Palette.foreground.with-alpha(0.04);

    if root.glyph == 0: Rectangle {
        x: 3px + (root.width - 6px) * root.fx;
        y: 3px + (root.height - 6px) * root.fy;
        width: (root.width - 6px) * root.fw;
        height: (root.height - 6px) * root.fh;
        border-radius: 1.5px;
        background: Palette.accent-background;
    }

    if root.glyph == 1: Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 7px;
        height: 12px;
        viewbox-width: 7;
        viewbox-height: 12;
        commands: "M 1.5 1.5 L 5.5 6 L 1.5 10.5";
        stroke: Palette.accent-background;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    if root.glyph == 2: Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 7px;
        height: 12px;
        viewbox-width: 7;
        viewbox-height: 12;
        commands: "M 5.5 1.5 L 1.5 6 L 5.5 10.5";
        stroke: Palette.accent-background;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

component KeyChip inherits Rectangle {
    in property <string> text;

    min-width: 26px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.foreground.with-alpha(0.14);
    background: Palette.foreground.with-alpha(0.07);

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        padding-top: 3px;
        padding-bottom: 3px;

        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 600;
            color: Palette.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component ShortcutPill inherits Rectangle {
    in property <[string]> keys;
    in property <bool> recording;
    callback activated();

    border-radius: 6px;
    border-width: root.recording ? 2px : 1px;
    border-color: root.recording ? Palette.accent-background : Palette.foreground.with-alpha(0.14);
    background: root.recording ? Palette.accent-background.with-alpha(0.12) : (area.has-hover ? Palette.foreground.with-alpha(0.09) : Palette.foreground.with-alpha(0.04));

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 4px;

        if root.recording: Text {
            text: "Press a shortcut... (Esc to cancel)";
            font-size: 12px;
            color: Palette.accent-background;
            vertical-alignment: center;
        }

        if !root.recording && root.keys.length == 0: Text {
            text: "Click to set";
            font-size: 12px;
            color: Ui.text-tertiary;
            vertical-alignment: center;
        }

        if !root.recording: HorizontalLayout {
            spacing: 4px;

            for key in root.keys: KeyChip {
                text: key;
            }
        }
    }

    if focus.has-focus && !root.recording: Rectangle {
        border-radius: 6px;
        border-width: 2px;
        border-color: Palette.accent-background;
    }

    area := TouchArea {
        clicked => {
            focus.focus();
            root.activated();
        }
    }
}

component ClearButton inherits Rectangle {
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: area.has-hover ? Palette.foreground.with-alpha(0.1) : transparent;

    Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 9px;
        height: 9px;
        viewbox-width: 9;
        viewbox-height: 9;
        commands: "M 1 1 L 8 8 M 8 1 L 1 8";
        stroke: Ui.text-secondary;
        stroke-width: 1.4px;
        stroke-line-cap: round;
    }

    area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component ShortcutRowItem inherits Rectangle {
    in property <ShortcutRow> data;
    in property <string> label;
    in property <float> fx;
    in property <float> fy;
    in property <float> fw: 1;
    in property <float> fh: 1;
    in property <int> glyph;
    callback record();
    callback clear();

    min-height: 58px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            LayoutIcon {
                fx: root.fx;
                fy: root.fy;
                fw: root.fw;
                fh: root.fh;
                glyph: root.glyph;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 1px;

            Text {
                text: root.label;
                font-size: 14px;
                color: Palette.foreground;
                overflow: elide;
            }

            if root.data.recording && root.data.hint != "": Text {
                text: root.data.hint;
                font-size: 12px;
                color: Ui.warning;
                overflow: elide;
            }

            if !root.data.recording && root.data.note != "": Text {
                text: root.data.note;
                font-size: 12px;
                color: root.data.warn ? Ui.warning : Palette.accent-background;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            ShortcutPill {
                keys: root.data.keys;
                recording: root.data.recording;
                activated => {
                    root.record();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            if root.data.keys.length > 0 && !root.data.recording: ClearButton {
                clicked => {
                    root.clear();
                }
            }

            if root.data.keys.length == 0 || root.data.recording: Rectangle {
                width: 28px;
                height: 28px;
            }
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;

    min-height: 62px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 14px;
                color: Palette.foreground;
                wrap: word-wrap;
            }

            if root.description != "": Text {
                text: root.description;
                font-size: 12px;
                color: Ui.text-secondary;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            @children
        }
    }
}

export component SettingsWindow inherits Window {
    in property <[ShortcutRow]> rows;
    in-out property <string> sizes-text;
    in-out property <string> sizes-error;
    in-out property <bool> startup-enabled;
    in-out property <bool> auto-update;
    in property <string> update-status;
    in property <bool> update-available;
    in property <bool> update-busy;
    in property <string> version-label;
    in property <int> theme-override;
    callback record(int);
    callback clear(int);
    callback cancel-recording();
    callback restore-defaults();
    callback apply-sizes(string) -> string;
    callback set-startup(bool);
    callback set-auto-update(bool);
    callback check-now();
    callback download();

    in-out property <int> page: 0;

    title: "Wectangle Settings";
    preferred-width: 680px;
    preferred-height: 760px;
    min-width: 520px;
    min-height: 360px;
    background: Palette.background;

    changed page => {
        root.cancel-recording();
    }

    changed theme-override => {
        if (self.theme-override == 1) {
            Palette.color-scheme = ColorScheme.light;
        } else if (self.theme-override == 2) {
            Palette.color-scheme = ColorScheme.dark;
        }
    }

    VerticalLayout {
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 10px;
            padding-bottom: 4px;
            spacing: 4px;
            alignment: start;

            PivotItem {
                text: "Shortcuts";
                selected: root.page == 0;
                activated => {
                    if (root.page == 1) {
                        root.sizes-error = root.apply-sizes(root.sizes-text);
                    }
                    root.page = 0;
                }
            }

            PivotItem {
                text: "General";
                selected: root.page == 1;
                activated => {
                    root.page = 1;
                }
            }
        }

        Divider {}

        if root.page == 0: ScrollView {
            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 20px;
                padding-bottom: 24px;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Keyboard shortcuts";
                    font-size: 22px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                Text {
                    text: "Click a shortcut to record a new one. Repeat a shortcut to cycle through sizes. Changes apply right away.";
                    font-size: 13px;
                    color: Ui.text-secondary;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 6px;
                }

                SectionTitle {
                    text: "Halves";
                }

                Card {
                    ShortcutRowItem {
                        data: root.rows[0];
                        label: "Left";
                        fw: 0.5;
                        record => {
                            root.record(0);
                        }
                        clear => {
                            root.clear(0);
                        }
                    }

                    Divider {}

                    ShortcutRowItem {
                        data: root.rows[1];
                        label: "Right";
                        fx: 0.5;
                        fw: 0.5;
                        record => {
                            root.record(1);
                        }
                        clear => {
                            root.clear(1);
                        }
                    }

                    Divider {}

                    ShortcutRowItem {
                        data: root.rows[2];
                        label: "Top";
                        fh: 0.5;
                        record => {
                            root.record(2);
                        }
                        clear => {
                            root.clear(2);
                        }
                    }

                    Divider {}

                    ShortcutRowItem {
                        data: root.rows[3];
                        label: "Bottom";
                        fy: 0.5;
                        fh: 0.5;
                        record => {
                            root.record(3);
                        }
                        clear => {
                            root.clear(3);
                        }
                    }
                }

                Rectangle {
                    height: 6px;
                }

                SectionTitle {
                    text: "Corners";
                }

                Card {
                    ShortcutRowItem {
                        data: root.rows[4];
                        label: "Top left";
                        fw: 0.5;
                        fh: 0.5;
                        record => {
                            root.record(4);
                        }
                        clear => {
                            root.clear(4);
                        }
                    }

                    Divider {}

                    ShortcutRowItem {
                        data: root.rows[5];
                        label: "Top right";
                        fx: 0.5;
                        fw: 0.5;
                        fh: 0.5;
                        record => {
                            root.record(5);
                        }
                        clear => {
                            root.clear(5);
                        }
                    }

                    Divider {}

                    ShortcutRowItem {
                        data: root.rows[6];
                        label: "Bottom left";
                        fy: 0.5;
                        fw: 0.5;
                        fh: 0.5;
                        record => {
                            root.record(6);
                        }
                        clear => {
                            root.clear(6);
                        }
                    }

                    Divider {}

                    ShortcutRowItem {
                        data: root.rows[7];
                        label: "Bottom right";
                        fx: 0.5;
                        fy: 0.5;
                        fw: 0.5;
                        fh: 0.5;
                        record => {
                            root.record(7);
                        }
                        clear => {
                            root.clear(7);
                        }
                    }
                }

                Rectangle {
                    height: 6px;
                }

                SectionTitle {
                    text: "Window";
                }

                Card {
                    ShortcutRowItem {
                        data: root.rows[8];
                        label: "Maximize / restore";
                        record => {
                            root.record(8);
                        }
                        clear => {
                            root.clear(8);
                        }
                    }

                    Divider {}

                    ShortcutRowItem {
                        data: root.rows[9];
                        label: "Center";
                        fx: 0.25;
                        fy: 0.2;
                        fw: 0.5;
                        fh: 0.6;
                        record => {
                            root.record(9);
                        }
                        clear => {
                            root.clear(9);
                        }
                    }
                }

                Rectangle {
                    height: 6px;
                }

                SectionTitle {
                    text: "Displays";
                }

                Card {
                    ShortcutRowItem {
                        data: root.rows[10];
                        label: "Next display";
                        glyph: 1;
                        record => {
                            root.record(10);
                        }
                        clear => {
                            root.clear(10);
                        }
                    }

                    Divider {}

                    ShortcutRowItem {
                        data: root.rows[11];
                        label: "Previous display";
                        glyph: 2;
                        record => {
                            root.record(11);
                        }
                        clear => {
                            root.clear(11);
                        }
                    }
                }

                Rectangle {
                    height: 6px;
                }

                HorizontalLayout {
                    alignment: start;

                    Button {
                        text: "Restore defaults";
                        clicked => {
                            root.restore-defaults();
                        }
                    }
                }
            }
        }

        if root.page == 1: ScrollView {
            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 20px;
                padding-bottom: 24px;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "General";
                    font-size: 22px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                Rectangle {
                    height: 6px;
                }

                SectionTitle {
                    text: "Window sizes";
                }

                Card {
                    SettingRow {
                        title: "Size cycle";
                        description: "Fractions or percentages, separated by commas. Repeating a shortcut steps through them.";

                        LineEdit {
                            preferred-width: 190px;
                            placeholder-text: "1/2, 2/3, 1/3";
                            text <=> root.sizes-text;
                            edited => {
                                root.sizes-error = "";
                            }
                            accepted => {
                                root.sizes-error = root.apply-sizes(self.text);
                            }
                            changed has-focus => {
                                if (!self.has-focus) {
                                    root.sizes-error = root.apply-sizes(self.text);
                                }
                            }
                        }
                    }

                    if root.sizes-error != "": HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-bottom: 12px;

                        Text {
                            text: root.sizes-error;
                            font-size: 12px;
                            color: Ui.error;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle {
                    height: 6px;
                }

                SectionTitle {
                    text: "Startup";
                }

                Card {
                    SettingRow {
                        title: "Launch at startup";
                        description: "Start Wectangle when you sign in to Windows.";

                        Switch {
                            text: self.checked ? "On" : "Off";
                            checked <=> root.startup-enabled;
                            toggled => {
                                root.set-startup(self.checked);
                            }
                        }
                    }
                }

                Rectangle {
                    height: 6px;
                }

                SectionTitle {
                    text: "Updates";
                }

                Card {
                    SettingRow {
                        title: "Check for updates automatically";
                        description: "Wectangle looks for a new release once a day.";

                        Switch {
                            text: self.checked ? "On" : "Off";
                            checked <=> root.auto-update;
                            toggled => {
                                root.set-auto-update(self.checked);
                            }
                        }
                    }

                    Divider {}

                    SettingRow {
                        title: root.update-status;

                        HorizontalLayout {
                            spacing: 8px;

                            if root.update-available: Button {
                                text: "Download";
                                primary: true;
                                clicked => {
                                    root.download();
                                }
                            }

                            Button {
                                text: "Check now";
                                enabled: !root.update-busy;
                                clicked => {
                                    root.check-now();
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 10px;
                }

                Text {
                    text: root.version-label;
                    font-size: 12px;
                    color: Ui.text-tertiary;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
