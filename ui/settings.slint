import { AboutSlint, Button, LineEdit, Palette, ScrollView, Switch } from "std-widgets.slint";

export struct ShortcutRow {
    label: string,
    keys: [string],
    note: string,
    warn: bool,
    recording: bool,
    hint: string,
}

struct RowSpec {
    index: int,
    fx: float,
    fy: float,
    fw: float,
    fh: float,
    glyph: int,
}

global Ui {
    out property <brush> text-secondary: Palette.foreground.with-alpha(0.72);
    out property <brush> text-tertiary: Palette.foreground.with-alpha(0.55);
    out property <brush> divider: Palette.foreground.with-alpha(0.08);
    out property <brush> card-border: Palette.foreground.with-alpha(0.1);
    out property <color> warning: Palette.color-scheme == ColorScheme.dark ? #ffc83d : #9d5d00;
    out property <color> error: Palette.color-scheme == ColorScheme.dark ? #ff99a4 : #c42b1c;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Ui.divider;
}

component Card inherits Rectangle {
    background: Palette.control-background;
    border-radius: 6px;
    border-width: 1px;
    border-color: Ui.card-border;

    VerticalLayout {
        alignment: start;

        @children
    }
}

component SectionTitle inherits Text {
    font-size: 13px;
    font-weight: 600;
    color: Palette.foreground;
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback activated();

    border-radius: 4px;
    background: area.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;

        label := Text {
            text: root.text;
            font-size: 14px;
            font-weight: 500;
            color: root.selected ? Palette.foreground : Ui.text-secondary;
            vertical-alignment: center;
            overflow: clip;
        }
    }

    Rectangle {
        visible: root.selected;
        x: 14px;
        y: parent.height - 3px;
        width: parent.width - 28px;
        height: 3px;
        border-radius: 1.5px;
        background: Palette.accent-background;
    }

    if focus.has-focus: Rectangle {
        border-radius: 4px;
        border-width: 2px;
        border-color: Palette.accent-background;
    }

    area := TouchArea {
        clicked => {
            root.activated();
        }
    }
}

component LayoutIcon inherits Rectangle {
    in property <float> fx;
    in property <float> fy;
    in property <float> fw;
    in property <float> fh;
    in property <int> glyph;

    width: 26px;
    height: 18px;
    border-radius: 3px;
    border-width: 1.5px;
    border-color: Palette.foreground.with-alpha(0.5);
    background: Palette.foreground.with-alpha(0.04);

    if root.glyph == 0: Rectangle {
        x: 2.5px + (root.width - 5px) * root.fx;
        y: 2.5px + (root.height - 5px) * root.fy;
        width: (root.width - 5px) * root.fw;
        height: (root.height - 5px) * root.fh;
        border-radius: 1.5px;
        background: Palette.accent-background;
    }

    if root.glyph == 1: Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 6px;
        height: 10px;
        viewbox-width: 6;
        viewbox-height: 10;
        commands: "M 1.3 1.3 L 4.7 5 L 1.3 8.7";
        stroke: Palette.accent-background;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    if root.glyph == 2: Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 6px;
        height: 10px;
        viewbox-width: 6;
        viewbox-height: 10;
        commands: "M 4.7 1.3 L 1.3 5 L 4.7 8.7";
        stroke: Palette.accent-background;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

component KeyChip inherits Rectangle {
    in property <string> text;

    min-width: 22px;
    border-radius: 3px;
    border-width: 1px;
    border-color: Palette.foreground.with-alpha(0.14);
    background: Palette.foreground.with-alpha(0.07);

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 2px;
        padding-bottom: 2px;

        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 600;
            color: Palette.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component ShortcutPill inherits Rectangle {
    in property <[string]> keys;
    in property <bool> recording;
    callback activated();

    border-radius: 5px;
    border-width: root.recording ? 2px : 1px;
    border-color: root.recording ? Palette.accent-background : Palette.foreground.with-alpha(0.14);
    background: root.recording ? Palette.accent-background.with-alpha(0.12) : (area.has-hover ? Palette.foreground.with-alpha(0.09) : Palette.foreground.with-alpha(0.04));

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 3px;

        if root.recording: Text {
            text: "Press a shortcut... (Esc to cancel)";
            font-size: 11px;
            color: Palette.accent-background;
            vertical-alignment: center;
        }

        if !root.recording && root.keys.length == 0: Text {
            text: "Click to set";
            font-size: 11px;
            color: Ui.text-tertiary;
            vertical-alignment: center;
        }

        if !root.recording: HorizontalLayout {
            spacing: 3px;

            for key in root.keys: KeyChip {
                text: key;
            }
        }
    }

    if focus.has-focus && !root.recording: Rectangle {
        border-radius: 5px;
        border-width: 2px;
        border-color: Palette.accent-background;
    }

    area := TouchArea {
        clicked => {
            root.activated();
        }
    }
}

component ClearButton inherits Rectangle {
    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: area.has-hover ? Palette.foreground.with-alpha(0.1) : transparent;

    Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 8px;
        height: 8px;
        viewbox-width: 8;
        viewbox-height: 8;
        commands: "M 1 1 L 7 7 M 7 1 L 1 7";
        stroke: Ui.text-secondary;
        stroke-width: 1.3px;
        stroke-line-cap: round;
    }

    area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component ShortcutRowItem inherits Rectangle {
    in property <ShortcutRow> data;
    in property <RowSpec> spec;
    in property <bool> divider;
    callback record();
    callback clear();

    min-height: 36px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            LayoutIcon {
                fx: root.spec.fx;
                fy: root.spec.fy;
                fw: root.spec.fw;
                fh: root.spec.fh;
                glyph: root.spec.glyph;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.data.label;
                font-size: 13px;
                color: Palette.foreground;
                overflow: elide;
            }

            if root.data.recording && root.data.hint != "": Text {
                text: root.data.hint;
                font-size: 11px;
                color: Ui.warning;
                overflow: elide;
            }

            if !root.data.recording && root.data.note != "": Text {
                text: root.data.note;
                font-size: 11px;
                color: root.data.warn ? Ui.warning : Palette.accent-background;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            ShortcutPill {
                keys: root.data.keys;
                recording: root.data.recording;
                activated => {
                    root.record();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            if root.data.keys.length > 0 && !root.data.recording: ClearButton {
                clicked => {
                    root.clear();
                }
            }

            if root.data.keys.length == 0 || root.data.recording: Rectangle {
                width: 24px;
                height: 24px;
            }
        }
    }

    if root.divider: Divider {
        y: 0px;
    }
}

component ShortcutGroup inherits VerticalLayout {
    in property <string> title;
    in property <[RowSpec]> specs;
    in property <[ShortcutRow]> rows;
    callback record(int);
    callback clear(int);

    spacing: 4px;

    SectionTitle {
        text: root.title;
    }

    Card {
        for item[i] in root.specs: ShortcutRowItem {
            data: root.rows[item.index];
            spec: item;
            divider: i > 0;
            record => {
                root.record(item.index);
            }
            clear => {
                root.clear(item.index);
            }
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;

    min-height: 58px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 16px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 14px;
                color: Palette.foreground;
                wrap: word-wrap;
            }

            if root.description != "": Text {
                text: root.description;
                font-size: 12px;
                color: Ui.text-secondary;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            @children
        }
    }
}

export component SettingsWindow inherits Window {
    in property <[ShortcutRow]> rows;
    in-out property <string> sizes-text;
    in-out property <string> sizes-error;
    in-out property <bool> startup-enabled;
    in-out property <bool> auto-update;
    in property <string> update-status;
    in property <string> update-detail;
    in property <bool> update-available;
    in property <bool> update-busy;
    in property <string> version;
    in property <int> theme-override;
    callback record(int);
    callback clear(int);
    callback cancel-recording();
    callback restore-defaults();
    callback apply-sizes(string) -> string;
    callback set-startup(bool);
    callback set-auto-update(bool);
    callback check-now();
    callback download();
    callback open-github();
    callback report-issue();

    in-out property <int> page: 0;

    property <[RowSpec]> halves: [
        { index: 0, fx: 0, fy: 0, fw: 0.5, fh: 1, glyph: 0 },
        { index: 1, fx: 0.5, fy: 0, fw: 0.5, fh: 1, glyph: 0 },
        { index: 2, fx: 0, fy: 0, fw: 1, fh: 0.5, glyph: 0 },
        { index: 3, fx: 0, fy: 0.5, fw: 1, fh: 0.5, glyph: 0 },
    ];
    property <[RowSpec]> corners: [
        { index: 4, fx: 0, fy: 0, fw: 0.5, fh: 0.5, glyph: 0 },
        { index: 5, fx: 0.5, fy: 0, fw: 0.5, fh: 0.5, glyph: 0 },
        { index: 6, fx: 0, fy: 0.5, fw: 0.5, fh: 0.5, glyph: 0 },
        { index: 7, fx: 0.5, fy: 0.5, fw: 0.5, fh: 0.5, glyph: 0 },
    ];
    property <[RowSpec]> window-actions: [
        { index: 8, fx: 0, fy: 0, fw: 1, fh: 1, glyph: 0 },
        { index: 9, fx: 0.25, fy: 0.2, fw: 0.5, fh: 0.6, glyph: 0 },
    ];
    property <[RowSpec]> displays: [
        { index: 10, fx: 0, fy: 0, fw: 0, fh: 0, glyph: 1 },
        { index: 11, fx: 0, fy: 0, fw: 0, fh: 0, glyph: 2 },
    ];

    title: "Wectangle Settings";
    preferred-width: 640px;
    preferred-height: 682px;
    min-width: 480px;
    min-height: 320px;
    background: Palette.background;

    changed page => {
        root.cancel-recording();
    }

    changed theme-override => {
        if (self.theme-override == 1) {
            Palette.color-scheme = ColorScheme.light;
        } else if (self.theme-override == 2) {
            Palette.color-scheme = ColorScheme.dark;
        }
    }

    VerticalLayout {
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 6px;
            padding-bottom: 3px;
            spacing: 2px;
            alignment: start;

            TabButton {
                height: 30px;
                text: "Shortcuts";
                selected: root.page == 0;
                activated => {
                    if (root.page == 1) {
                        root.sizes-error = root.apply-sizes(root.sizes-text);
                    }
                    root.page = 0;
                }
            }

            TabButton {
                height: 30px;
                text: "General";
                selected: root.page == 1;
                activated => {
                    root.page = 1;
                }
            }

            TabButton {
                height: 30px;
                text: "About";
                selected: root.page == 2;
                activated => {
                    if (root.page == 1) {
                        root.sizes-error = root.apply-sizes(root.sizes-text);
                    }
                    root.page = 2;
                }
            }
        }

        Divider {}

        if root.page == 0: ScrollView {
            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 10px;
                padding-bottom: 12px;
                spacing: 10px;
                alignment: start;

                Text {
                    text: "Click a shortcut to record a new one. Repeat a shortcut to cycle through sizes. Changes apply right away.";
                    font-size: 12px;
                    color: Ui.text-secondary;
                    wrap: word-wrap;
                }

                ShortcutGroup {
                    title: "Halves";
                    specs: root.halves;
                    rows: root.rows;
                    record(index) => {
                        root.record(index);
                    }
                    clear(index) => {
                        root.clear(index);
                    }
                }

                ShortcutGroup {
                    title: "Corners";
                    specs: root.corners;
                    rows: root.rows;
                    record(index) => {
                        root.record(index);
                    }
                    clear(index) => {
                        root.clear(index);
                    }
                }

                ShortcutGroup {
                    title: "Window";
                    specs: root.window-actions;
                    rows: root.rows;
                    record(index) => {
                        root.record(index);
                    }
                    clear(index) => {
                        root.clear(index);
                    }
                }

                ShortcutGroup {
                    title: "Displays";
                    specs: root.displays;
                    rows: root.rows;
                    record(index) => {
                        root.record(index);
                    }
                    clear(index) => {
                        root.clear(index);
                    }
                }

                HorizontalLayout {
                    alignment: start;

                    Button {
                        text: "Restore defaults";
                        clicked => {
                            root.restore-defaults();
                        }
                    }
                }
            }
        }

        if root.page == 1: ScrollView {
            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 14px;
                padding-bottom: 20px;
                spacing: 10px;
                alignment: start;

                VerticalLayout {
                    spacing: 4px;

                    SectionTitle {
                        text: "Window sizes";
                    }

                    Card {
                        SettingRow {
                            title: "Size cycle";
                            description: "Fractions or percentages, separated by commas. Repeating a shortcut steps through them.";

                            LineEdit {
                                preferred-width: 190px;
                                placeholder-text: "1/2, 2/3, 1/3";
                                text <=> root.sizes-text;
                                edited => {
                                    root.sizes-error = "";
                                }
                                accepted => {
                                    root.sizes-error = root.apply-sizes(self.text);
                                }
                                changed has-focus => {
                                    if (!self.has-focus) {
                                        root.sizes-error = root.apply-sizes(self.text);
                                    }
                                }
                            }
                        }

                        if root.sizes-error != "": HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-bottom: 12px;

                            Text {
                                text: root.sizes-error;
                                font-size: 12px;
                                color: Ui.error;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 4px;

                    SectionTitle {
                        text: "Startup";
                    }

                    Card {
                        SettingRow {
                            title: "Launch at startup";
                            description: "Start Wectangle when you sign in to Windows.";

                            Switch {
                                text: self.checked ? "On" : "Off";
                                checked <=> root.startup-enabled;
                                toggled => {
                                    root.set-startup(self.checked);
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 4px;

                    SectionTitle {
                        text: "Updates";
                    }

                    Card {
                        SettingRow {
                            title: "Check for updates automatically";
                            description: "Wectangle looks for a new release once a day.";

                            Switch {
                                text: self.checked ? "On" : "Off";
                                checked <=> root.auto-update;
                                toggled => {
                                    root.set-auto-update(self.checked);
                                }
                            }
                        }

                        Divider {}

                        SettingRow {
                            title: root.update-status;

                            HorizontalLayout {
                                spacing: 8px;

                                if root.update-available: Button {
                                    text: "Download";
                                    primary: true;
                                    clicked => {
                                        root.download();
                                    }
                                }

                                Button {
                                    text: "Check now";
                                    enabled: !root.update-busy;
                                    clicked => {
                                        root.check-now();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.page == 2: ScrollView {
            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 28px;
                padding-bottom: 20px;
                spacing: 6px;
                alignment: start;

                HorizontalLayout {
                    alignment: center;

                    Image {
                        source: @image-url("../assets/wectangle-256.png");
                        width: 72px;
                        height: 72px;
                    }
                }

                Text {
                    text: "Wectangle";
                    font-size: 22px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Version " + root.version;
                    font-size: 13px;
                    color: Ui.text-secondary;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Rectangle-style keyboard window management for Windows.";
                    font-size: 13px;
                    color: Palette.foreground;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Text {
                    text: "© 2026 Zolfer Figueiredo";
                    font-size: 12px;
                    color: Ui.text-tertiary;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 8px;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    Button {
                        text: "GitHub";
                        clicked => {
                            root.open-github();
                        }
                    }

                    Button {
                        text: "Report an issue";
                        clicked => {
                            root.report-issue();
                        }
                    }

                    Button {
                        text: "Check for updates";
                        enabled: !root.update-busy;
                        clicked => {
                            root.check-now();
                        }
                    }

                    if root.update-available: Button {
                        text: "Download";
                        primary: true;
                        clicked => {
                            root.download();
                        }
                    }
                }

                if root.update-detail != "": Text {
                    text: root.update-detail;
                    font-size: 12px;
                    color: Ui.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 12px;
                }

                HorizontalLayout {
                    alignment: center;

                    Card {
                        AboutSlint {
                            preferred-width: 220px;
                            preferred-height: 150px;
                        }
                    }
                }
            }
        }
    }
}
