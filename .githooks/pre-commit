#!/bin/sh
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
    echo "Commits directly to main are not allowed. Switch to a feature branch." >&2
    exit 1
fi

if ! cargo fmt --check; then
    echo "cargo fmt --check failed. Run 'cargo fmt' and restage your changes." >&2
    exit 1
fi

if git grep --cached -nI -e '—' -e '–' -- 'src/*.rs'; then
    echo "Em or en dash found in staged Rust source. Remove it." >&2
    exit 1
fi

exit 0
